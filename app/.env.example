# Wyłącznie dla administratorów. Uczestnicy używają panelu Model AI.
# Streamlit nie wczytuje tego pliku automatycznie; run_docker.sh przyjmuje ENV_FILE.
# Domyślny tryb lokalny nie wymaga żadnych zmiennych.
LAB_PUBLIC_SERVER=0
# Launcher desktopowy ustawia LAB_DESKTOP=1 i LAB_USER_DIR oraz katalogi poniżej.
# LAB_DESKTOP=1
# LAB_USER_DIR=/katalog/danych/uzytkownika
# DATA_DIR=./dane
# LOG_DIR=./logs
# CACHE_DIR=./cache

# Publiczny serwer zajęć: LAB_PUBLIC_SERVER=1 oraz jawne adresy operatora.
# Modele nie pojawiają się bez ORNITH_BASE_URL(S) / QWEN_BASE_URL.
ORNITH_BASE_URL=
ORNITH_BASE_URLS=
ORNITH_MODEL=ornith-1.5-9b
ORNITH_MAX_CONCURRENCY_PER_SERVER=4
ORNITH_API_KEY=
ORNITH_API_KEY_FILE=
ORNITH_LABEL=Ornith
ORNITH_REASONING_EFFORT=
QWEN_BASE_URL=
QWEN_MODEL=umed-qwen
QWEN_API_KEY=
QWEN_API_KEY_FILE=
QWEN_LABEL=Qwen
QWEN_REASONING_EFFORT=

# Opcjonalny adres operatora, np. osobny kontener w docker-compose.
# Puste = domyślnie http://127.0.0.1:11434. Publicznie ignorowany.
OLLAMA_BASE_URL=
