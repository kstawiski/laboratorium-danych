# Przykład konfiguracji. Streamlit nie wczytuje automatycznie tego pliku.
# Ustaw zmienne w powłoce; run_docker.sh obsługuje ENV_FILE dla zmiennych modelu.
# Użyj DATA_DIR=tests/fixtures do samodzielnej próby bez zewnętrznego pakietu.
DATA_DIR=./dane
LOG_DIR=./logs
CACHE_DIR=./cache
ORNITH_BASE_URL=http://localhost:11434/v1
ORNITH_BASE_URLS=
ORNITH_MODEL=ornith-1.5:9b
ORNITH_MAX_CONCURRENCY_PER_SERVER=4
ORNITH_API_KEY=
ORNITH_API_KEY_FILE=
QWEN_BASE_URL=http://localhost:4000/v1
QWEN_MODEL=umed-qwen
QWEN_API_KEY=
QWEN_API_KEY_FILE=
